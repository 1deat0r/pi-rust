#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Portable cargo resolution: the hook must run on any host, not just the
# machine that installed it. Prefer rustup/cargo on PATH, then $HOME/.cargo.
resolve_cargo() {
  if command -v cargo >/dev/null 2>&1; then
    command -v cargo
  elif [[ -x "$HOME/.cargo/bin/cargo" ]]; then
    echo "$HOME/.cargo/bin/cargo"
  else
    echo "pre-commit: cargo not found on PATH or at \$HOME/.cargo/bin/cargo" >&2
    return 1
  fi
}
CARGO="$(resolve_cargo)" || exit 1

staged_files="$(git diff --cached --name-only --diff-filter=ACMRTUXB)"
if [[ -z "$staged_files" ]]; then
  exit 0
fi

# Disk/source size gate runs first (cheap, fails fast): reject oversized
# tracked files, staged build artifacts, and accidental binaries before any
# cargo audit builds.
if ! bash scripts/size-gate.sh; then
  echo "pre-commit: size-gate failed" >&2
  exit 1
fi

# A source/configuration change is only commit-ready when the durable project
# handoff is part of the same checkpoint. README.md is also the GitHub README.
# Workflow-infrastructure changes (.githooks, scripts, lint config, CI) carry
# no product behavior and are exempt from the checkpoint-doc bundle.
requires_docs=0
while IFS= read -r path; do
  case "$path" in
    README.md|PLAN.md|CONVERSION-LEDGER.md|HANDOFF.md|AGENTS.md|GATES.md|.githooks/*|.github/*|scripts/*|.markdownlint-cli2.jsonc|.github/workflows/*|docs/*)
      # Checkpoint docs, workflow infra, registers, dashboard, archives:
      # none of these is product source, so none forces the bundle alone.
      ;;
    *)
      requires_docs=1
      ;;
  esac
done <<< "$staged_files"

# The non-TUI register is an acceptance source, not ordinary documentation.
# Any change to a live register row must carry the synchronized project
# checkpoint documents too. (Frozen archives — docs/*-ARCHIVE-*.md — and the
# dashboard's retired-narrative section are history, not acceptance sources:
# staging them must not force the checkpoint bundle.)
if grep -Fxq "docs/NON-TUI-PARITY-STATUS.md" <<< "$staged_files"; then
  requires_docs=1
fi

if [[ "$requires_docs" -eq 1 ]]; then
  # Bundle rule (2026-09-18 fix): a source change is only commit-ready with
  # the checkpoint docs staged. Only docs whose content actually changed in
  # this commit are required — unchanged files stage as no-ops and must not
  # block. README.md always carries the machine-checked status block, so a
  # source change without a README content change stages it only if metrics
  # moved (checked below); otherwise the checkpoint trio suffices.
  required_docs=(PLAN.md CONVERSION-LEDGER.md HANDOFF.md docs/NON-TUI-PARITY-STATUS.md)
  for doc in "${required_docs[@]}"; do
    if ! grep -Fxq "$doc" <<< "$staged_files"; then
      echo "pre-commit: implementation changes require staged $doc" >&2
      exit 1
    fi
  done

  # Metric-sync rule: the bundle above fires only when a carrier file is
  # staged. Carriers of the full metric set are README.md plus the
  # registers and dashboard (PLAN/HANDOFF/CONVERSION-LEDGER are
  # append-only logs — archived snapshots are never rewritten). The
  # unconditional carrier checks below enforce sync on every commit.
  progress_output="$("$CARGO" run -p pi-coding-agent --offline --quiet --bin conversion_audit -- progress)"
  progress_percent="$(sed -E 's/^Conversion progress: ([0-9]+\.[0-9]+)%.*/\1%/p' <<< "$progress_output")"
  if [[ -z "$progress_percent" ]]; then
    echo "pre-commit: unable to parse conversion-progress output" >&2
    exit 1
  fi
  for doc in PLAN.md CONVERSION-LEDGER.md HANDOFF.md docs/NON-TUI-PARITY-STATUS.md; do
    if grep -Fxq "$doc" <<< "$staged_files" && ! grep -Fq "$progress_percent" "$doc"; then
      echo "pre-commit: staged $doc does not contain current progress $progress_percent" >&2
      exit 1
    fi
  done
fi

# Recompute all four TUI dimensions from the 52-row register. The hook does
# not turn partial work into PASS; it rejects a checkpoint whose durable docs
# still advertise an older measurement. Only the registers, dashboard, and
# README carry the full metric set: PLAN/HANDOFF/CONVERSION-LEDGER are
# append-only session logs whose archived snapshots must not be rewritten to
# satisfy the linter of the present (see the 2026-09-17 doc-hygiene pass).
tui_output="$("$CARGO" run -p pi-coding-agent --offline --quiet --bin parity_audit -- tui)"
tui_metrics="$(sed -n '/^TUI /p' <<< "$tui_output")"
if [[ -z "$tui_metrics" ]]; then
  echo "pre-commit: unable to parse TUI parity metrics" >&2
  exit 1
fi
for doc in README.md docs/TUI-PARITY-STATUS.md; do
  while IFS= read -r metric; do
    if ! grep -Fxq "$metric" "$doc"; then
      echo "pre-commit: $doc does not contain current TUI metric: $metric" >&2
      exit 1
    fi
  done <<< "$tui_metrics"
done

# Recompute the complete progress dashboard, including the source-ledger
# percentage, inventory/scoring coverage, root-gate closure, TUI dimensions,
# and normalized non-TUI status dimensions. Same scoping as the TUI check:
# only the registers, dashboard, and README carry the full metric set.
dashboard_output="$("$CARGO" run -p pi-coding-agent --offline --quiet --bin parity_audit -- dashboard)"
dashboard_metrics="$(sed -n '/^Source\/conversion ledger:/,/^Whole-product behavioral parity:/p' <<< "$dashboard_output")"
if [[ -z "$dashboard_metrics" ]]; then
  echo "pre-commit: unable to parse parity dashboard metrics" >&2
  exit 1
fi
for doc in README.md docs/TUI-PARITY-STATUS.md docs/PARITY-DASHBOARD.md; do
  while IFS= read -r metric; do
    if ! grep -Fxq "$metric" "$doc"; then
      echo "pre-commit: $doc does not contain current dashboard metric: $metric" >&2
      exit 1
    fi
  done <<< "$dashboard_metrics"
done

git diff --cached --check

# Living workflow docs stay machine-clean: README.md and AGENTS.md must pass
# markdownlint per .markdownlint-cli2.jsonc whenever they are staged.
# Historical registers and appendices are grandfathered (see that config).
if grep -Fxq "README.md" <<< "$staged_files" || grep -Fxq "AGENTS.md" <<< "$staged_files"; then
  if ! bash scripts/docs-lint.sh >/dev/null 2>&1; then
    echo "pre-commit: README.md/AGENTS.md fail docs-lint; run bash scripts/docs-lint.sh" >&2
    bash scripts/docs-lint.sh 2>&1 | tail -8 >&2 || true
    exit 1
  fi
fi

# GitHub repository metadata is external state. Sync it when the authenticated
# CLI is available; otherwise leave a visible, non-blocking reminder so local
# commits remain recoverable while pushes/authentication are being repaired.
description_file=".github/repository-description.txt"
if command -v gh >/dev/null 2>&1 && [[ -f "$description_file" ]]; then
  description="$(tr '\n' ' ' < "$description_file" | sed -E 's/[[:space:]]+/ /g; s/[[:space:]]+$//')"
  if gh auth status >/dev/null 2>&1; then
    if ! gh repo edit --description "$description" >/dev/null; then
      echo "pre-commit: warning: GitHub description sync failed" >&2
    fi
  else
    echo "pre-commit: warning: GitHub CLI is not authenticated; description not synced" >&2
  fi
fi
